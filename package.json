{
  "name": "@zontafor/luxleaf-scene-kit",
  "version": "0.2.0",
  "type": "module",
  "license": "LicenseRef-Proprietary",
  "author": "Michelle L. Wu",
  "description": "React scene composition, complete Fiber entry points, owned asset lifecycles and portable scene documents.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fiber": {
      "types": "./dist/fiber.d.ts",
      "import": "./dist/fiber.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third_party",
    "docs",
    "foundations",
    "src",
    "demo",
    "tests",
    "scripts",
    "integrations",
    "tsconfig.json",
    "tsconfig.build.json",
    "vite.config.ts",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run verify:foundation && npm run typecheck && npm test && npm run build",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:foundation": "node scripts/verify-foundation.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@react-three/test-renderer": "^9.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.187.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zontafor/luxleaf-scene-kit.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
