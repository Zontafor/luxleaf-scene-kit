{
  "name": "@luxleaf/scene-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "LicenseRef-Proprietary",
  "author": "Michelle L. Wu",
  "description": "Typed React scenes, deliberate lighting, orbit interaction and validated material presets, built on React Three Fiber and Three.js.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third_party",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "@react-three/fiber": "9.8.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "tsx": "^4.20.0",
    "@types/three": "0.187.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Zontafor/luxleaf-scene-kit.git"
  }
}
